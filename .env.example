# Soren Desktop Agent Framework — Environment Configuration
# Copy to .env and adjust as needed: cp .env.example .env
#
# Soren uses a dedicated Ollama instance on port 11435 so you can run a separate
# server with Soren-specific config (OLLAMA_MAX_LOADED_MODELS=1, etc.) alongside
# your default Ollama on 11434.
#
# For Ollama server vars: Must be set when starting the Ollama server.
# If you run `ollama serve` manually: source .env && ollama serve
# For brew services: edit ~/Library/LaunchAgents/homebrew.mxcl.ollama.plist
#   (or use a separate launchd plist for the Soren instance on 11435)

# -----------------------------------------------------------------------------
# Ollama connection — Soren uses port 11435 by default
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11435

# -----------------------------------------------------------------------------
# Ollama server (32 GB memory safeguard — set when starting ollama serve)
# -----------------------------------------------------------------------------
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# -----------------------------------------------------------------------------
# Lume VM (optional overrides)
# -----------------------------------------------------------------------------
# LUME_URL=http://localhost:7777
